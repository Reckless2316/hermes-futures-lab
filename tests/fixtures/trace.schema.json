{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "provenance",
    "calendar",
    "events",
    "expected_checkpoints"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "vendor",
        "dataset_id",
        "input_path",
        "input_sha256",
        "license",
        "synthetic",
        "original_timezone",
        "adapter_version",
        "instrument_spec_ids",
        "gaps",
        "correction_policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "input_path": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "const": true
        },
        "original_timezone": {
          "const": "UTC"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "instrument_spec_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "gaps": {
          "type": "array",
          "maxItems": 0
        },
        "correction_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "timezone",
        "sessions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "const": "America/New_York"
        },
        "sessions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session_id",
              "start_utc",
              "close_utc"
            ],
            "properties": {
              "session_id": {
                "type": "string",
                "format": "date"
              },
              "start_utc": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "close_utc": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "event_id",
          "event_type",
          "account_id",
          "source",
          "source_event_id",
          "timestamp_utc",
          "session_id",
          "sequence",
          "provenance_id",
          "payload"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "enum": [
              "InstrumentSpec",
              "RulesetSelected",
              "OrderIntent",
              "OrderAccepted",
              "Fill",
              "Commission",
              "MarketEvent",
              "PositionMark",
              "SessionClose"
            ]
          },
          "account_id": {
            "type": "string",
            "pattern": "^lab-"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_event_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp_utc": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "session_id": {
            "type": "string",
            "format": "date"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "provenance_id": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "InstrumentSpec"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "instrument_id",
                    "symbol",
                    "venue",
                    "currency",
                    "tick_size",
                    "tick_value",
                    "multiplier",
                    "mini_equivalent",
                    "expiry",
                    "calendar_id",
                    "roll_policy",
                    "ftmo_counting_class"
                  ],
                  "properties": {
                    "instrument_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "symbol": {
                      "type": "string",
                      "minLength": 1
                    },
                    "venue": {
                      "type": "string",
                      "minLength": 1
                    },
                    "currency": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tick_size": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+$",
                      "not": {
                        "pattern": "[\\r\\n]"
                      }
                    },
                    "tick_value": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+$",
                      "not": {
                        "pattern": "[\\r\\n]"
                      }
                    },
                    "multiplier": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+$",
                      "not": {
                        "pattern": "[\\r\\n]"
                      }
                    },
                    "mini_equivalent": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+$",
                      "not": {
                        "pattern": "[\\r\\n]"
                      }
                    },
                    "expiry": {
                      "type": "string",
                      "format": "date"
                    },
                    "calendar_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "roll_policy": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ftmo_counting_class": {
                      "enum": [
                        "standard",
                        "mini",
                        "micro"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "RulesetSelected"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ruleset_id",
                    "rules_version",
                    "ruleset_sha256"
                  ],
                  "properties": {
                    "ruleset_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "rules_version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ruleset_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "OrderIntent"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "order_id",
                    "instrument_id",
                    "side",
                    "quantity",
                    "order_type"
                  ],
                  "properties": {
                    "order_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "instrument_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "side": {
                      "enum": [
                        "buy",
                        "sell"
                      ]
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "order_type": {
                      "const": "market"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "OrderAccepted"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "order_id",
                    "intent_event_id"
                  ],
                  "properties": {
                    "order_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "intent_event_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "Fill"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "fill_id",
                    "order_id",
                    "instrument_id",
                    "side",
                    "quantity",
                    "price"
                  ],
                  "properties": {
                    "fill_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "order_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "instrument_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "side": {
                      "enum": [
                        "buy",
                        "sell"
                      ]
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "price": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+$",
                      "not": {
                        "pattern": "[\\r\\n]"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "Commission"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "fill_id",
                    "amount",
                    "currency"
                  ],
                  "properties": {
                    "fill_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "amount": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
                      "not": {
                        "pattern": "[\\r\\n]"
                      }
                    },
                    "currency": {
                      "const": "USD"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "MarketEvent"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "instrument_id",
                    "kind",
                    "price",
                    "volume"
                  ],
                  "properties": {
                    "instrument_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "const": "trade"
                    },
                    "price": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+$",
                      "not": {
                        "pattern": "[\\r\\n]"
                      }
                    },
                    "volume": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "PositionMark"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "instrument_id",
                    "price",
                    "market_event_id"
                  ],
                  "properties": {
                    "instrument_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "price": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+$",
                      "not": {
                        "pattern": "[\\r\\n]"
                      }
                    },
                    "market_event_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "SessionClose"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "calendar_id"
                  ],
                  "properties": {
                    "calendar_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "expected_checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "after_event_id",
          "balance",
          "unrealized",
          "equity",
          "floor",
          "open_positions"
        ],
        "properties": {
          "after_event_id": {
            "type": "string",
            "minLength": 1
          },
          "balance": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "unrealized": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "equity": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "floor": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "open_positions": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P0 synthetic trace subset; not the P1 importer schema"
}
